# Copy this file to .env and replace the development password with a strong value.
# Use a URL-safe password or percent-encode reserved characters in both URLs below.
POSTGRES_USER=itdesk
POSTGRES_PASSWORD=replace-with-a-long-random-development-password
POSTGRES_DB=itdesk

# Used when running the API directly on the host.
DATABASE_URL=postgresql://itdesk:replace-with-a-long-random-development-password@localhost:5432/itdesk?schema=public
# Used by Compose containers; keep credentials consistent with POSTGRES_* above.
DATABASE_URL_DOCKER=postgresql://itdesk:replace-with-a-long-random-development-password@database:5432/itdesk?schema=public
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
NODE_ENV=development
WEB_PORT=8080
JWT_ACCESS_SECRET=replace-with-at-least-32-random-bytes-before-use
PUBLIC_APP_URL=http://localhost:5173
C
# Leave SMTP empty to disable email workflows; those requests will return an explicit error.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./storage
MAX_UPLOAD_BYTES=10485760
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
