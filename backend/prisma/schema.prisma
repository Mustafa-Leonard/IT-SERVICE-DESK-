generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TicketStatus {
  NEW
  OPEN
  IN_PROGRESS
  WAITING_ON_REQUESTER
  WAITING_ON_VENDOR
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum CommentVisibility {
  PUBLIC
  INTERNAL
}

enum AssetStatus {
  IN_STOCK
  ASSIGNED
  UNDER_REPAIR
  LOST
  DAMAGED
  RETIRED
  DISPOSED
}

enum AssetCondition {
  NEW
  GOOD
  FAIR
  POOR
  DAMAGED
}

enum DeviceType {
  ROUTER
  SWITCH
  FIREWALL
  ACCESS_POINT
  SERVER
  PRINTER
  OTHER
}

enum DeviceStatus {
  ONLINE
  OFFLINE
  DEGRADED
  MAINTENANCE
  UNKNOWN
}

enum StatusSource {
  MANUAL
  MONITOR
}

enum IpAssignmentType {
  STATIC
  DHCP
  RESERVED
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model Organization {
  id                 String               @id @default(uuid()) @db.Uuid
  name               String
  slug               String               @unique
  createdAt          DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime             @updatedAt @db.Timestamptz(6)
  users              User[]
  roles              Role[]
  departments        Department[]
  locations          Location[]
  tickets            Ticket[]
  ticketCategories   TicketCategory[]
  slaPolicies        SlaPolicy[]
  incidents          Incident[]
  problems           Problem[]
  changeRequests     ChangeRequest[]
  approvals          Approval[]
  maintenanceTasks   MaintenanceTask[]
  assetCategories    AssetCategory[]
  assets             Asset[]
  networkDevices     NetworkDevice[]
  subnets            Subnet[]
  ipAddresses        IpAddress[]
  vlans              Vlan[]
  networkConnections NetworkConnection[]
  networkIncidents   NetworkIncident[]
  networkMaintenance NetworkMaintenance[]
  knowledgeArticles  KnowledgeArticle[]
  notifications      Notification[]
  auditLogs          AuditLog[]
  settings           SystemSetting[]
}

model User {
  id                   String                   @id @default(uuid()) @db.Uuid
  organizationId       String                   @db.Uuid
  departmentId         String?                  @db.Uuid
  locationId           String?                  @db.Uuid
  email                String
  displayName          String
  passwordHash         String
  isActive             Boolean                  @default(false)
  emailVerifiedAt      DateTime?                @db.Timestamptz(6)
  failedLoginAttempts  Int                      @default(0)
  lockedUntil          DateTime?                @db.Timestamptz(6)
  createdAt            DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime                 @updatedAt @db.Timestamptz(6)
  organization         Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  department           Department?              @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  location             Location?                @relation(fields: [locationId], references: [id], onDelete: SetNull)
  roles                UserRole[]
  rolesAssigned        UserRole[]               @relation("RoleAssignedBy")
  sessions             RefreshSession[]
  activationTokens     AccountActivationToken[]
  passwordResetTokens  PasswordResetToken[]
  requestedTickets     Ticket[]                 @relation("TicketRequester")
  assignedTickets      Ticket[]                 @relation("TicketAssignee")
  ticketComments       TicketComment[]
  assignmentsMade      TicketAssignment[]       @relation("TicketAssignedBy")
  assignmentsReceived  TicketAssignment[]       @relation("TicketAssignedTo")
  statusChanges        TicketStatusHistory[]
  incidentsReported    Incident[]               @relation("IncidentReporter")
  problemsReported     Problem[]                @relation("ProblemReporter")
  changesRequested     ChangeRequest[]          @relation("ChangeRequester")
  approvals            Approval[]               @relation("ApprovalActor")
  approvalsDecided     Approval[]               @relation("ApprovalDecider")
  maintenanceTasks     MaintenanceTask[]        @relation("MaintenanceAssignee")
  assetAssignments     AssetAssignment[]        @relation("AssetAssignedUser")
  assetAssignmentsMade AssetAssignment[]        @relation("AssetAssignmentActor")
  assetTransfers       AssetTransfer[]          @relation("AssetTransferActor")
  assetMaintenance     AssetMaintenance[]       @relation("AssetMaintenanceActor")
  assetDisposals       AssetDisposal[]          @relation("AssetDisposalActor")
  administeredDevices  NetworkDevice[]          @relation("DeviceAdministrator")
  deviceStatusChanges  DeviceStatusHistory[]
  configurations       DeviceConfiguration[]    @relation("ConfigurationAuthor")
  networkIncidents     NetworkIncident[]        @relation("NetworkIncidentReporter")
  networkMaintenance   NetworkMaintenance[]     @relation("NetworkMaintenanceActor")
  knowledgeArticles    KnowledgeArticle[]       @relation("KnowledgeAuthor")
  knowledgeRevisions   KnowledgeRevision[]
  notifications        Notification[]
  auditLogs            AuditLog[]
  attachments          Attachment[]

  @@unique([organizationId, email])
  @@index([organizationId, departmentId])
  @@index([organizationId, isActive])
}

model Role {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  key            String
  name           String
  description    String?
  isSystem       Boolean          @default(false)
  createdAt      DateTime         @default(now()) @db.Timestamptz(6)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users          UserRole[]
  permissions    RolePermission[]

  @@unique([organizationId, key])
  @@index([organizationId, name])
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique
  description String
  roles       RolePermission[]
}

model UserRole {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  roleId       String   @db.Uuid
  assignedById String?  @db.Uuid
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedBy   User?    @relation("RoleAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  @@unique([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Department {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @db.Uuid
  name           String
  slug           String
  isActive       Boolean        @default(true)
  createdAt      DateTime        @default(now()) @db.Timestamptz(6)
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users          User[]
  tickets        Ticket[]
  assets         Asset[]
  transfersFrom  AssetTransfer[] @relation("TransferFromDepartment")
  transfersTo    AssetTransfer[] @relation("TransferToDepartment")

  @@unique([organizationId, slug])
  @@index([organizationId, name])
}

model Location {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @db.Uuid
  name           String
  code           String
  address        String?
  isActive       Boolean        @default(true)
  createdAt      DateTime        @default(now()) @db.Timestamptz(6)
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users          User[]
  subnets        Subnet[]
  assets         Asset[]
  devices        NetworkDevice[]
  transfersFrom  AssetTransfer[] @relation("TransferFromLocation")
  transfersTo    AssetTransfer[] @relation("TransferToLocation")

  @@unique([organizationId, code])
  @@index([organizationId, name])
}

model RefreshSession {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique
  userAgent  String?
  ipAddress  String?
  expiresAt  DateTime  @db.Timestamptz(6)
  lastUsedAt DateTime  @default(now()) @db.Timestamptz(6)
  revokedAt  DateTime? @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @db.Timestamptz(6)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model AccountActivationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz(6)
  usedAt    DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz(6)
  usedAt    DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model TicketCategory {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  name           String
  slug           String
  isActive       Boolean      @default(true)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tickets        Ticket[]

  @@unique([organizationId, slug])
}

model SlaPolicy {
  id                      String       @id @default(uuid()) @db.Uuid
  organizationId          String       @db.Uuid
  name                    String
  responseTargetMinutes   Int
  resolutionTargetMinutes Int
  isActive                Boolean      @default(true)
  createdAt               DateTime     @default(now()) @db.Timestamptz(6)
  organization            Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tickets                 Ticket[]

  @@index([organizationId, isActive])
}

model Ticket {
  id              String                @id @default(uuid()) @db.Uuid
  organizationId  String                @db.Uuid
  requesterId     String                @db.Uuid
  assignedToId    String?               @db.Uuid
  departmentId    String?               @db.Uuid
  categoryId      String?               @db.Uuid
  slaPolicyId     String?               @db.Uuid
  problemId       String?               @db.Uuid
  ticketNumber    String
  subject         String
  description     String
  status          TicketStatus          @default(NEW)
  priority        TicketPriority        @default(NORMAL)
  firstResponseAt DateTime?             @db.Timestamptz(6)
  resolvedAt      DateTime?             @db.Timestamptz(6)
  responseDueAt   DateTime?             @db.Timestamptz(6)
  resolutionDueAt DateTime?             @db.Timestamptz(6)
  createdAt       DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime              @updatedAt @db.Timestamptz(6)
  organization    Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  requester       User                  @relation("TicketRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  assignedTo      User?                 @relation("TicketAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  department      Department?           @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  category        TicketCategory?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  slaPolicy       SlaPolicy?            @relation(fields: [slaPolicyId], references: [id], onDelete: SetNull)
  problem         Problem?              @relation(fields: [problemId], references: [id], onDelete: SetNull)
  assignments     TicketAssignment[]
  comments        TicketComment[]
  statusHistory   TicketStatusHistory[]
  attachments     Attachment[]
  approvals       Approval[]
  incidents       Incident[]

  @@unique([organizationId, ticketNumber])
  @@index([organizationId, status, priority, createdAt])
  @@index([requesterId, createdAt])
  @@index([assignedToId, status])
}

model TicketAssignment {
  id           String   @id @default(uuid()) @db.Uuid
  ticketId     String   @db.Uuid
  assignedToId String   @db.Uuid
  assignedById String?  @db.Uuid
  note         String?
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  ticket       Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  assignedTo   User     @relation("TicketAssignedTo", fields: [assignedToId], references: [id], onDelete: Restrict)
  assignedBy   User?    @relation("TicketAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
  @@index([assignedToId, createdAt])
}

model TicketComment {
  id          String            @id @default(uuid()) @db.Uuid
  ticketId    String            @db.Uuid
  authorId    String            @db.Uuid
  body        String
  visibility  CommentVisibility @default(PUBLIC)
  createdAt   DateTime          @default(now()) @db.Timestamptz(6)
  ticket      Ticket            @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author      User              @relation(fields: [authorId], references: [id], onDelete: Restrict)
  attachments Attachment[]

  @@index([ticketId, createdAt])
}

model TicketStatusHistory {
  id        String        @id @default(uuid()) @db.Uuid
  ticketId  String        @db.Uuid
  actorId   String?       @db.Uuid
  from      TicketStatus?
  to        TicketStatus
  note      String?
  createdAt DateTime      @default(now()) @db.Timestamptz(6)
  ticket    Ticket        @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actor     User?         @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
}

model Incident {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  ticketId       String?          @db.Uuid
  reporterId     String           @db.Uuid
  title          String
  description    String
  severity       IncidentSeverity @default(MEDIUM)
  status         String           @default("OPEN")
  rootCause      String?
  createdAt      DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @db.Timestamptz(6)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  ticket         Ticket?          @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  reporter       User             @relation("IncidentReporter", fields: [reporterId], references: [id], onDelete: Restrict)

  @@index([organizationId, severity, status])
}

model Problem {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  reporterId     String       @db.Uuid
  title          String
  description    String
  rootCause      String?
  status         String       @default("OPEN")
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  reporter       User         @relation("ProblemReporter", fields: [reporterId], references: [id], onDelete: Restrict)
  tickets        Ticket[]

  @@index([organizationId, status])
}

model ChangeRequest {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  requesterId    String       @db.Uuid
  title          String
  description    String
  risk           String
  plannedStart   DateTime?    @db.Timestamptz(6)
  plannedEnd     DateTime?    @db.Timestamptz(6)
  status         String       @default("DRAFT")
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  requester      User         @relation("ChangeRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  approvals      Approval[]

  @@index([organizationId, status])
}

model Approval {
  id              String         @id @default(uuid()) @db.Uuid
  organizationId  String         @db.Uuid
  ticketId        String?        @db.Uuid
  changeRequestId String?        @db.Uuid
  requestedById   String         @db.Uuid
  approverId      String?        @db.Uuid
  status          ApprovalStatus @default(PENDING)
  decisionNote    String?
  createdAt       DateTime       @default(now()) @db.Timestamptz(6)
  decidedAt       DateTime?      @db.Timestamptz(6)
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  ticket          Ticket?        @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  changeRequest   ChangeRequest? @relation(fields: [changeRequestId], references: [id], onDelete: Cascade)
  requestedBy     User           @relation("ApprovalActor", fields: [requestedById], references: [id], onDelete: Restrict)
  approver        User?          @relation("ApprovalDecider", fields: [approverId], references: [id], onDelete: SetNull)

  @@index([organizationId, status, createdAt])
}

model MaintenanceTask {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  assigneeId     String?      @db.Uuid
  title          String
  description    String?
  scheduledAt    DateTime?    @db.Timestamptz(6)
  completedAt    DateTime?    @db.Timestamptz(6)
  status         String       @default("OPEN")
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  assignee       User?        @relation("MaintenanceAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([organizationId, status, scheduledAt])
}

model AssetCategory {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  name           String
  slug           String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assets         Asset[]

  @@unique([organizationId, slug])
}

model Asset {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @db.Uuid
  categoryId     String?            @db.Uuid
  departmentId   String?            @db.Uuid
  locationId     String?            @db.Uuid
  assetTag       String
  serialNumber   String?
  name           String
  manufacturer   String?
  model          String?
  specifications Json?
  purchaseDate   DateTime?          @db.Date
  purchaseCost   Decimal?           @db.Decimal(12, 2)
  supplier       String?
  warrantyUntil  DateTime?          @db.Date
  condition      AssetCondition     @default(GOOD)
  status         AssetStatus        @default(IN_STOCK)
  createdAt      DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime           @updatedAt @db.Timestamptz(6)
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  category       AssetCategory?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  department     Department?        @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  location       Location?          @relation(fields: [locationId], references: [id], onDelete: SetNull)
  assignments    AssetAssignment[]
  transfers      AssetTransfer[]
  maintenance    AssetMaintenance[]
  disposal       AssetDisposal?

  @@unique([organizationId, assetTag])
  @@index([organizationId, status, name])
  @@index([organizationId, serialNumber])
}

model AssetAssignment {
  id           String    @id @default(uuid()) @db.Uuid
  assetId      String    @db.Uuid
  userId       String    @db.Uuid
  assignedById String?   @db.Uuid
  assignedAt   DateTime  @default(now()) @db.Timestamptz(6)
  returnedAt   DateTime? @db.Timestamptz(6)
  note         String?
  asset        Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  user         User      @relation("AssetAssignedUser", fields: [userId], references: [id], onDelete: Restrict)
  assignedBy   User?     @relation("AssetAssignmentActor", fields: [assignedById], references: [id], onDelete: SetNull)

  @@index([assetId, assignedAt])
  @@index([userId, returnedAt])
}

model AssetTransfer {
  id               String      @id @default(uuid()) @db.Uuid
  assetId          String      @db.Uuid
  fromDepartmentId String?     @db.Uuid
  toDepartmentId   String?     @db.Uuid
  actorId          String?     @db.Uuid
  fromLocationId   String?     @db.Uuid
  toLocationId     String?     @db.Uuid
  note             String?
  createdAt        DateTime    @default(now()) @db.Timestamptz(6)
  asset            Asset       @relation(fields: [assetId], references: [id], onDelete: Cascade)
  fromDepartment   Department? @relation("TransferFromDepartment", fields: [fromDepartmentId], references: [id], onDelete: SetNull)
  toDepartment     Department? @relation("TransferToDepartment", fields: [toDepartmentId], references: [id], onDelete: SetNull)
  actor            User?       @relation("AssetTransferActor", fields: [actorId], references: [id], onDelete: SetNull)
  fromLocation     Location?   @relation("TransferFromLocation", fields: [fromLocationId], references: [id], onDelete: SetNull)
  toLocation       Location?   @relation("TransferToLocation", fields: [toLocationId], references: [id], onDelete: SetNull)

  @@index([assetId, createdAt])
}

model AssetMaintenance {
  id          String    @id @default(uuid()) @db.Uuid
  assetId     String    @db.Uuid
  actorId     String?   @db.Uuid
  description String
  cost        Decimal?  @db.Decimal(12, 2)
  vendor      String?
  startedAt   DateTime? @db.Timestamptz(6)
  completedAt DateTime? @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  asset       Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  actor       User?     @relation("AssetMaintenanceActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([assetId, createdAt])
}

model AssetDisposal {
  id         String   @id @default(uuid()) @db.Uuid
  assetId    String   @unique @db.Uuid
  actorId    String?  @db.Uuid
  method     String
  notes      String?
  disposedAt DateTime @default(now()) @db.Timestamptz(6)
  asset      Asset    @relation(fields: [assetId], references: [id], onDelete: Restrict)
  actor      User?    @relation("AssetDisposalActor", fields: [actorId], references: [id], onDelete: SetNull)
}

model NetworkDevice {
  id                 String                @id @default(uuid()) @db.Uuid
  organizationId     String                @db.Uuid
  locationId         String?               @db.Uuid
  administratorId    String?               @db.Uuid
  name               String
  type               DeviceType
  manufacturer       String?
  model              String?
  serialNumber       String?
  managementIp       String?
  macAddress         String?
  firmwareVersion    String?
  status             DeviceStatus          @default(UNKNOWN)
  statusSource       StatusSource          @default(MANUAL)
  statusUpdatedAt    DateTime              @default(now()) @db.Timestamptz(6)
  createdAt          DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime              @updatedAt @db.Timestamptz(6)
  organization       Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  location           Location?             @relation(fields: [locationId], references: [id], onDelete: SetNull)
  administrator      User?                 @relation("DeviceAdministrator", fields: [administratorId], references: [id], onDelete: SetNull)
  statusHistory      DeviceStatusHistory[]
  ipAddresses        IpAddress[]
  vlanDevices        VlanDevice[]
  connectionsA       NetworkConnection[]   @relation("ConnectionA")
  connectionsB       NetworkConnection[]   @relation("ConnectionB")
  configurations     DeviceConfiguration[]
  incidents          NetworkIncident[]
  maintenanceRecords NetworkMaintenance[]

  @@unique([organizationId, name])
  @@index([organizationId, type, status])
  @@index([organizationId, managementIp])
}

model DeviceStatusHistory {
  id         String        @id @default(uuid()) @db.Uuid
  deviceId   String        @db.Uuid
  actorId    String?       @db.Uuid
  status     DeviceStatus
  source     StatusSource  @default(MANUAL)
  note       String?
  observedAt DateTime      @default(now()) @db.Timestamptz(6)
  device     NetworkDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  actor      User?         @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([deviceId, observedAt])
}

model Subnet {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  locationId     String?      @db.Uuid
  cidr           String
  gateway        String?
  dnsServers     String[]
  name           String
  description    String?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  location       Location?    @relation(fields: [locationId], references: [id], onDelete: SetNull)
  addresses      IpAddress[]
  vlanSubnets    VlanSubnet[]

  @@unique([organizationId, cidr])
  @@index([organizationId, name])
}

model IpAddress {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  subnetId       String?          @db.Uuid
  deviceId       String?          @db.Uuid
  address        String
  assignmentType IpAssignmentType @default(STATIC)
  description    String?
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  subnet         Subnet?          @relation(fields: [subnetId], references: [id], onDelete: SetNull)
  device         NetworkDevice?   @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@unique([organizationId, address])
  @@index([subnetId, assignmentType])
}

model Vlan {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  vlanId         Int
  name           String
  purpose        String?
  isActive       Boolean      @default(true)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  subnets        VlanSubnet[]
  devices        VlanDevice[]

  @@unique([organizationId, vlanId])
}

model VlanSubnet {
  vlanId   String @db.Uuid
  subnetId String @db.Uuid
  vlan     Vlan   @relation(fields: [vlanId], references: [id], onDelete: Cascade)
  subnet   Subnet @relation(fields: [subnetId], references: [id], onDelete: Cascade)

  @@id([vlanId, subnetId])
}

model VlanDevice {
  vlanId   String        @db.Uuid
  deviceId String        @db.Uuid
  vlan     Vlan          @relation(fields: [vlanId], references: [id], onDelete: Cascade)
  device   NetworkDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@id([vlanId, deviceId])
}

model NetworkConnection {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  deviceAId      String        @db.Uuid
  deviceBId      String        @db.Uuid
  description    String?
  createdAt      DateTime      @default(now()) @db.Timestamptz(6)
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  deviceA        NetworkDevice @relation("ConnectionA", fields: [deviceAId], references: [id], onDelete: Cascade)
  deviceB        NetworkDevice @relation("ConnectionB", fields: [deviceBId], references: [id], onDelete: Cascade)

  @@unique([organizationId, deviceAId, deviceBId])
  @@index([organizationId])
}

model DeviceConfiguration {
  id                 String        @id @default(uuid()) @db.Uuid
  deviceId           String        @db.Uuid
  authorId           String?       @db.Uuid
  backupAttachmentId String?       @unique @db.Uuid
  version            String?
  changeDescription  String
  createdAt          DateTime      @default(now()) @db.Timestamptz(6)
  device             NetworkDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  author             User?         @relation("ConfigurationAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  backupAttachment   Attachment?   @relation("ConfigurationBackup", fields: [backupAttachmentId], references: [id], onDelete: SetNull)

  @@index([deviceId, createdAt])
}

model NetworkIncident {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  deviceId       String?          @db.Uuid
  reporterId     String?          @db.Uuid
  title          String
  description    String
  severity       IncidentSeverity @default(MEDIUM)
  status         String           @default("OPEN")
  createdAt      DateTime         @default(now()) @db.Timestamptz(6)
  resolvedAt     DateTime?        @db.Timestamptz(6)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  device         NetworkDevice?   @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  reporter       User?            @relation("NetworkIncidentReporter", fields: [reporterId], references: [id], onDelete: SetNull)

  @@index([organizationId, status, severity])
}

model NetworkMaintenance {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  deviceId       String?        @db.Uuid
  actorId        String?        @db.Uuid
  title          String
  description    String?
  scheduledAt    DateTime?      @db.Timestamptz(6)
  completedAt    DateTime?      @db.Timestamptz(6)
  status         String         @default("PLANNED")
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  device         NetworkDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  actor          User?          @relation("NetworkMaintenanceActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, scheduledAt])
}

model Attachment {
  id                  String               @id @default(uuid()) @db.Uuid
  organizationId      String               @db.Uuid
  uploadedById        String               @db.Uuid
  ticketId            String?              @db.Uuid
  commentId           String?              @db.Uuid
  originalName        String
  mediaType           String
  size                Int
  sha256              String
  storageKey          String               @unique
  createdAt           DateTime             @default(now()) @db.Timestamptz(6)
  ticket              Ticket?              @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  comment             TicketComment?       @relation(fields: [commentId], references: [id], onDelete: Cascade)
  uploadedBy          User                 @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  deviceConfiguration DeviceConfiguration? @relation("ConfigurationBackup")

  @@index([organizationId, createdAt])
  @@index([ticketId])
  @@index([commentId])
}

model KnowledgeArticle {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @db.Uuid
  authorId       String              @db.Uuid
  title          String
  slug           String
  summary        String?
  publishedAt    DateTime?           @db.Timestamptz(6)
  createdAt      DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime            @updatedAt @db.Timestamptz(6)
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  author         User                @relation("KnowledgeAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  revisions      KnowledgeRevision[]

  @@unique([organizationId, slug])
  @@index([organizationId, publishedAt])
}

model KnowledgeRevision {
  id        String           @id @default(uuid()) @db.Uuid
  articleId String           @db.Uuid
  authorId  String           @db.Uuid
  body      String
  createdAt DateTime         @default(now()) @db.Timestamptz(6)
  article   KnowledgeArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  author    User             @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([articleId, createdAt])
}

model Notification {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  userId         String       @db.Uuid
  title          String
  body           String
  link           String?
  readAt         DateTime?    @db.Timestamptz(6)
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

model AuditLog {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  actorId        String?      @db.Uuid
  action         String
  targetType     String
  targetId       String?
  metadata       Json?
  ipAddress      String?
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actor          User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([organizationId, actorId, createdAt])
  @@index([targetType, targetId])
}

model SystemSetting {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  key            String
  value          Json
  updatedAt      DateTime     @updatedAt @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
}
